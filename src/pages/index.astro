---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CoreConcept from '../components/CoreConcept.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import HowItWorks from '../components/HowItWorks.astro';
import MealKitsExplorer from '../components/MealKitsExplorer.astro';
import Benefits from '../components/Benefits.astro';
import TargetAudience from '../components/TargetAudience.astro';
