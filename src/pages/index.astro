>
  <Navbar />
  <main>
    <Hero />
    <CoreConcept />
    <ProblemSolution />
    <HowItWorks />
    <MealKitsExplorer />
    <Benefits />
    <TargetAudience />
    <LaunchZone />
    <SocialOrdering />
    <FAQ />
    <CTASection />
  </main>
  <Footer />
