---
import socialData from '../../public/contents/SocialOrdering.json';
---

<section id="channels" class="py-20 md:py-28 bg-white border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-emerald-800 text-xs font-bold uppercase tracking-wider mb-3">
        <span class="lang-km">{socialData.badge.km}</span>
        <span class="lang-en">{socialData.badge.en}</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
        <span class="lang-km">{socialData.title.km}</span>
        <span class="lang-en">{socialData.title.en}</span>
      </h2>
      <p class="text-base sm:text-lg text-stone-600">
        <span class="lang-km">{socialData.description.km}</span>
        <span class="lang-en">{socialData.description.en}</span>
      </p>
    </div>

    <!-- 4 Channel Cards Grid from JSON -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {socialData.channels.map((channel) => (
        <a
          href={channel.href}
          target={channel.id !== 'phone' ? '_blank' : undefined}
          rel={channel.id !== 'phone' ? 'noopener noreferrer' : undefined}
          class="rounded-3xl p-6 bg-stone-50 border border-stone-200 hover:border-emerald-500 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group"
        >
          <div>
            <div class={`w-12 h-12 rounded-2xl text-white flex items-center justify-center mb-4 shadow-md ${
              channel.id === 'telegram' ? 'bg-[#229ED9] shadow-[#229ED9]/30' :
              channel.id === 'facebook' ? 'bg-[#1877F2] shadow-[#1877F2]/30' :
              channel.id === 'tiktok' ? 'bg-stone-900 shadow-stone-900/30' :
              'bg-emerald-600 shadow-emerald-600/30'
            }`}>
              {channel.id === 'telegram' && (
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
                </svg>
              )}
              {channel.id === 'facebook' && (
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              )}
              {channel.id === 'tiktok' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-tiktok" viewBox="0 0 16 16">
                  <path d="M9 0h1.98c.144.715.54 1.617 1.235 2.512C12.895 3.389 13.797 4 15 4v2c-1.753 0-3.07-.814-4-1.829V11a5 5 0 1 1-5-5v2a3 3 0 1 0 3 3z"/>
                </svg>
              )}
              {channel.id === 'phone' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              )}
            </div>
            <h3 class="font-bold text-lg text-stone-900 mb-1">{channel.name}</h3>
            <p class="text-xs text-stone-500 mb-4 leading-relaxed">
              <span class="lang-km">{channel.descKm}</span>
              <span class="lang-en">{channel.descEn}</span>
            </p>
          </div>
          <span class="text-xs font-bold text-emerald-700 group-hover:underline flex items-center gap-1">
            <span class="lang-km">{channel.actionKm}</span>
            <span class="lang-en">{channel.actionEn}</span>
          </span>
        </a>
      ))}
    </div>

    <!-- Live Stream Showcase Box with YouTube Cooking Show Video Background -->
    <div class="rounded-3xl bg-stone-950 text-white p-8 sm:p-10 shadow-2xl relative overflow-hidden border border-emerald-900/40">
      
      <!-- Video Background (YouTube Cooking Show Embed) -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
        <iframe
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[270%] h-[270%] min-w-full min-h-full object-cover opacity-100 filter brightness-90 contrast-110"
          src={socialData.liveShowcase.youtubeEmbedUrl || "https://www.youtube.com/embed/Ak34skdOeNI?autoplay=1&mute=1&loop=1&playlist=kEwNkhd5j5A&controls=0&showinfo=0&rel=0&iv_load_policy=3&disablekb=1&playsinline=1"}
          title="Live Cooking Show Background Video"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        ></iframe>
        <!-- Atmospheric Gradient Overlay for Text Readability -->
        <div class="absolute inset-0 bg-linear-to-r from-stone-950/95 via-stone-900/85 to-emerald-950/90"></div>
      </div>

      <!-- Foreground Content -->
      <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <div class="inline-flex items-center gap-2 py-1 px-3 rounded-full text-red-400 text-xs font-bold mb-4 backdrop-blur-xs">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
            <span>{socialData.liveShowcase.tag}</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold mb-3">
            <span class="lang-km">{socialData.liveShowcase.titleKm}</span>
            <span class="lang-en">{socialData.liveShowcase.titleEn}</span>
          </h3>
          <p class="text-sm text-stone-300 leading-relaxed mb-6 max-w-xl">
            <span class="lang-km">{socialData.liveShowcase.descKm}</span>
            <span class="lang-en">{socialData.liveShowcase.descEn}</span>
          </p>
          <div class="flex flex-wrap gap-4 text-xs font-semibold">
            {socialData.liveShowcase.features.map((feat) => (
              <div class="flex items-center gap-2">
                <span class="text-emerald-400">✓</span>
                <span class="lang-km">{feat.km}</span>
                <span class="lang-en">{feat.en}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
