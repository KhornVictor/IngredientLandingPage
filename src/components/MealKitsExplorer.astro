---
import mealKitsData from '../../public/contents/MealKits.json';
import company from '../../public/contents/Company.json';
---

<section id="kits" class="py-20 md:py-28 bg-white border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <span class="inline-block py-1 rounded-full text-emerald-800 text-xs font-bold uppercase tracking-wider mb-3">
          <span class="lang-km">{mealKitsData.badge.km}</span>
          <span class="lang-en">{mealKitsData.badge.en}</span>
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-3">
          <span class="lang-km">{mealKitsData.title.km}</span>
          <span class="lang-en">{mealKitsData.title.en}</span>
        </h2>
        <p class="text-base text-stone-600">
          <span class="lang-km">{mealKitsData.description.km}</span>
          <span class="lang-en">{mealKitsData.description.en}</span>
        </p>
      </div>

      <!-- Global Portion Size Switcher Filter -->
      <div class="bg-stone-100 p-1.5 rounded-2xl flex items-center shrink-0 border border-stone-200">
        <button
          type="button"
          id="portion-btn-small"
          class="portion-toggle-btn active-portion px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition-all duration-200 flex items-center gap-1.5 bg-white text-emerald-800 shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          <span class="lang-km">{mealKitsData.portionSmall.labelKm}</span>
          <span class="lang-en">{mealKitsData.portionSmall.labelEn}</span>
        </button>
        <button
          type="button"
          id="portion-btn-large"
          class="portion-toggle-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-stone-500 hover:text-stone-800 transition-all duration-200 flex items-center gap-1.5"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <span class="lang-km">{mealKitsData.portionLarge.labelKm}</span>
          <span class="lang-en">{mealKitsData.portionLarge.labelEn}</span>
        </button>
      </div>
    </div>

    <!-- Meal Kits Grid from JSON -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {mealKitsData.kits.map((kit) => (
        <div class="rounded-3xl border border-stone-200 bg-white p-5 flex flex-col justify-between hover:shadow-xl hover:border-emerald-400 transition-all duration-300 group">
          <div>
            <!-- Header Tag -->
            <div class="flex items-center justify-between mb-3">
              <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-bold ${
                kit.tagColor === 'emerald' ? 'bg-emerald-100 text-emerald-800' :
                kit.tagColor === 'amber' ? 'bg-amber-100 text-amber-800' :
                kit.tagColor === 'teal' ? 'bg-teal-100 text-teal-800' :
                'bg-orange-100 text-orange-800'
              }`}>
                <span class="lang-km">{kit.tagKm}</span>
                <span class="lang-en">{kit.tagEn}</span>
              </span>
              <div class="flex items-center gap-1 text-[11px] font-semibold text-stone-500">
                <svg class="w-3.5 h-3.5 text-amber-500 fill-current" viewBox="0 0 20 20">
                  <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                </svg>
                <span>{kit.rating}</span>
              </div>
            </div>

            <!-- Dish Visual Banner with Background Image from JSON -->
            <div class="relative rounded-2xl overflow-hidden p-5 text-center mb-4 border border-stone-200/80 group-hover:scale-[1.02] transition-transform shadow-xs min-h-42.5 flex flex-col justify-end">
              <img
                src={kit.image || '/lemongrass.png'}
                alt={kit.dishEn}
                class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-linear-to-t from-stone-950/95 via-stone-950/60 to-stone-900/20"></div>

              <div class="relative z-10">
                <h3 class="font-extrabold text-base text-white leading-snug drop-shadow-md">
                  <span class="lang-km">{kit.dishKm}</span>
                  <span class="lang-en">{kit.dishEn}</span>
                </h3>
                <div class="flex items-center justify-center gap-3 mt-2 text-[11px] text-stone-200 font-medium drop-shadow-sm">
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>{kit.cookTime}</span>
                  </span>
                  <span>•</span>
                  <span class="lang-km">{kit.difficultyKm}</span>
                  <span class="lang-en">{kit.difficultyEn}</span>
                </div>
              </div>
            </div>

            <!-- Ingredients List with Dynamic Portions -->
            <div class="space-y-1.5 mb-5 text-xs text-stone-600">
              <div class="font-bold text-stone-900 text-[11px] uppercase tracking-wider mb-2">
                <span class="lang-km">គ្រឿងផ្សំវាស់ស្រេចក្នុងប្រអប់៖</span>
                <span class="lang-en">Pre-Measured Ingredients:</span>
              </div>
              {kit.ingredients.map((ing) => (
                <div class="flex justify-between items-center py-1 border-b border-stone-100">
                  <span class="flex items-center gap-1.5 min-w-0">
                    <span class="shrink-0 flex items-center justify-center" set:html={ing.icon} />
                    <span class="truncate">
                      <span class="lang-km">{ing.nameKm}</span>
                      <span class="lang-en">{ing.nameEn}</span>
                    </span>
                  </span>
                  <span class="font-semibold text-stone-900 portion-text-item shrink-0 pl-2" data-portion-2={ing.portion2} data-portion-4={ing.portion4}>{ing.portion2}</span>
                </div>
              ))}
            </div>

            <!-- Video tutorial badge -->
            <div class="flex items-center gap-2 p-2 rounded-xl bg-stone-50 border border-stone-200/80 text-[11px] text-stone-600 mb-5">
              <span class="text-emerald-600 shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
              </span>
              <span class="lang-km">{kit.videoTextKm}</span>
              <span class="lang-en">{kit.videoTextEn}</span>
            </div>
          </div>

          <!-- Price & CTA -->
          <div class="pt-3 border-t border-stone-100">
            <div class="flex items-center justify-between mb-3">
              <div>
                <span class="text-[10px] text-stone-400 uppercase font-semibold">
                  <span class="lang-km">តម្លៃឈុត</span>
                  <span class="lang-en">Price</span>
                </span>
                <div class="flex items-baseline gap-1">
                  <span class="text-xl font-black text-stone-900 price-usd" data-price-2={kit.priceSmall.usd} data-price-4={kit.priceLarge.usd}>{kit.priceSmall.usd}</span>
                  <span class="text-xs text-stone-500 price-khr" data-price-khr-2={kit.priceSmall.khr} data-price-khr-4={kit.priceLarge.khr}>{kit.priceSmall.khr}</span>
                </div>
              </div>
              <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md current-portion-badge">
                <span class="lang-km">{mealKitsData.portionSmall.labelKm}</span>
                <span class="lang-en">{mealKitsData.portionSmall.labelEn}</span>
              </span>
            </div>

            <a
              href={company.socialLinks.telegram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow-xs transition-all active:scale-95"
            >
              <span class="lang-km">កុម្ម៉ង់ឈុតនេះ</span>
              <span class="lang-en">Order This Kit</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Custom Request Note -->
    <div class="mt-12 text-center p-6 rounded-3xl bg-stone-50 border border-dashed border-stone-300">
      <p class="text-sm text-stone-600 mb-2">
        <span class="lang-km">{mealKitsData.customNote.textKm}</span>
        <span class="lang-en">{mealKitsData.customNote.textEn}</span>
      </p>
      <a href={company.socialLinks.telegram} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 underline">
        <span class="lang-km">{mealKitsData.customNote.linkKm}</span>
        <span class="lang-en">{mealKitsData.customNote.linkEn}</span>
      </a>
    </div>

  </div>
</section>

<script is:inline>
  // Interactive Portion Selector Logic
  const btnSmall = document.getElementById('portion-btn-small');
  const btnLarge = document.getElementById('portion-btn-large');

  function updatePortion(size) {
    if (size === 2) {
      btnSmall?.classList.add('bg-white', 'text-emerald-800', 'shadow-xs');
      btnSmall?.classList.remove('text-stone-500');
      btnLarge?.classList.remove('bg-white', 'text-emerald-800', 'shadow-xs');
      btnLarge?.classList.add('text-stone-500');

      document.querySelectorAll('.portion-text-item').forEach(el => {
        el.textContent = el.getAttribute('data-portion-2');
      });

      document.querySelectorAll('.price-usd').forEach(el => {
        el.textContent = el.getAttribute('data-price-2');
      });

      document.querySelectorAll('.price-khr').forEach(el => {
        el.textContent = el.getAttribute('data-price-khr-2');
      });

      document.querySelectorAll('.current-portion-badge').forEach(el => {
        el.innerHTML = '<span class="lang-km">ឈុត ២-៣ នាក់</span><span class="lang-en">2-3 People</span>';
      });
    } else {
      btnLarge?.classList.add('bg-white', 'text-emerald-800', 'shadow-xs');
      btnLarge?.classList.remove('text-stone-500');
      btnSmall?.classList.remove('bg-white', 'text-emerald-800', 'shadow-xs');
      btnSmall?.classList.add('text-stone-500');

      document.querySelectorAll('.portion-text-item').forEach(el => {
        el.textContent = el.getAttribute('data-portion-4');
      });

      document.querySelectorAll('.price-usd').forEach(el => {
        el.textContent = el.getAttribute('data-price-4');
      });

      document.querySelectorAll('.price-khr').forEach(el => {
        el.textContent = el.getAttribute('data-price-khr-4');
      });

      document.querySelectorAll('.current-portion-badge').forEach(el => {
        el.innerHTML = '<span class="lang-km">ឈុត ៤-៥ នាក់</span><span class="lang-en">4-5 People</span>';
      });
    }
  }

  btnSmall?.addEventListener('click', () => updatePortion(2));
  btnLarge?.addEventListener('click', () => updatePortion(4));
</script>
