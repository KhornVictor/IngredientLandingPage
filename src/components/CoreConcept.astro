---
import concept from '../../public/contents/CoreConcept.json';
---

<section id="concept" class="py-16 md:py-24 bg-white border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl text-white p-8 sm:p-12 lg:p-16 shadow-2xl relative overflow-hidden border border-stone-700/60 group">
      <!-- Background Image -->
      <img
        src={concept.bgImage}
        alt="Fresh Cooking Ingredients"
        class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-102 transition-transform duration-700"
      />
      <!-- Dark Gradient Overlay for Maximum Text Readability -->
      <div class="absolute inset-0 bg-linear-to-r from-stone-950/95 via-stone-950/85 to-stone-950/50"></div>

      <div class="relative z-10 max-w-3xl">
        <span class="inline-block px-3.5 py-1 rounded-full text-emerald-100 text-xs font-bold uppercase tracking-wider mb-4">
          <span class="lang-km">{concept.badge.km}</span>
          <span class="lang-en">{concept.badge.en}</span>
        </span>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
          <span class="lang-km block">{concept.title.km}</span>
          <span class="lang-en block">{concept.title.en}</span>
        </h2>

        <p class="text-base sm:text-lg text-emerald-100/90 leading-relaxed mb-8">
          <span class="lang-km">{concept.description.km}</span>
          <span class="lang-en">{concept.description.en}</span>
        </p>

        <!-- 3 Core Concept Pillars from JSON -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {concept.pillars.map((pillar) => (
            <div class="p-4 rounded-2xl bg-stone-950/65 backdrop-blur-md border border-white/20 hover:border-emerald-400/50 transition-colors">
              <span class="text-2xl block mb-2 text-emerald-400">
                {pillar.icon === 'package' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package preview-icon"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><polyline points="3.29 7 12 12 20.71 7"/><path d="m7.5 4.27 9 5.15"/></svg>
                )}
                {pillar.icon === 'zap' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap preview-icon"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"/></svg>
                )}
                {pillar.icon === 'clapperboard' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clapperboard preview-icon"><path d="m12.296 3.464 3.02 3.956"/><path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3z"/><path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="m6.18 5.276 3.1 3.899"/></svg>
                )}
              </span>
              <h4 class="font-bold text-sm text-white mb-1">
                <span class="lang-km">{pillar.titleKm}</span>
                <span class="lang-en">{pillar.titleEn}</span>
              </h4>
              <p class="text-xs text-stone-300">
                <span class="lang-km">{pillar.descKm}</span>
                <span class="lang-en">{pillar.descEn}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
