---
import launchData from '../../public/contents/LaunchZone.json';
---

<section id="location" class="py-20 md:py-28 bg-stone-50/70 border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Operations & Strategy from JSON -->
      <div class="lg:col-span-6">
        <span class="inline-block py-1 rounded-full text-emerald-800 text-xs font-bold uppercase tracking-wider mb-3">
          <span class="lang-km">{launchData.badge.km}</span>
          <span class="lang-en">{launchData.badge.en}</span>
        </span>
        
        <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
          <span class="lang-km">ចាប់ផ្តើមដំបូងនៅ <span class="text-emerald-700 underline decoration-emerald-300">{launchData.title.cityHighlight}</span></span>
          <span class="lang-en">{launchData.title.en}</span>
        </h2>

        <p class="text-base text-stone-600 mb-6 leading-relaxed">
          <span class="lang-km">{launchData.description.km}</span>
          <span class="lang-en">{launchData.description.en}</span>
        </p>

        <!-- 3 Key Operations Pillars from JSON -->
        <div class="space-y-4 mb-8">
          {launchData.pillars.map((pillar) => (
            <div class="flex items-start gap-3.5 p-3.5 rounded-2xl bg-white border border-stone-200 shadow-xs">
              <span class={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 text-emerald-600`}>
                <Fragment set:html={pillar.icon} />
              </span>
              <div>
                <h4 class="text-sm font-bold text-stone-900">
                  <span class="lang-km">{pillar.titleKm}</span>
                  <span class="lang-en">{pillar.titleEn}</span>
                </h4>
                <p class="text-xs text-stone-500">
                  <span class="lang-km">{pillar.descKm}</span>
                  <span class="lang-en">{pillar.descEn}</span>
                </p>
              </div>
            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Interactive Map Mockup Card from JSON -->
      <div class="lg:col-span-6">
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-stone-200 shadow-xl relative overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
              <span class="font-bold text-sm text-stone-900">
                <span class="lang-km">{launchData.map.titleKm}</span>
                <span class="lang-en">{launchData.map.titleEn}</span>
              </span>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full text-emerald-800">
              <span class="lang-km">{launchData.map.statusKm}</span>
              <span class="lang-en">{launchData.map.statusEn}</span>
            </span>
          </div>

          <!-- Real Interactive Battambang (BTB) Map Container -->
          <div class="rounded-2xl border border-stone-200/80 relative overflow-hidden my-4 shadow-sm min-h-90 sm:min-h-95 bg-stone-100 flex flex-col justify-end">
            <!-- Google Maps Live Embed of Battambang City -->
            <iframe
              title="Battambang City Coverage Map"
              src={launchData.map.embedUrl || "https://maps.google.com/maps?q=Battambang%20City,%20Cambodia&z=14&output=embed"}
              class="absolute inset-0 w-full h-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>

            <!-- Floating Hub Info & Delivery Zones Overlay -->
            <div class="relative z-10 m-3 sm:m-4 p-3.5 sm:p-4 rounded-2xl bg-white/95 backdrop-blur-md border border-stone-200/90 shadow-xl">
              <div class="flex items-start justify-between gap-3 mb-2">
                <div class="flex items-center gap-2.5">
                  <span class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-xs">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                  </span>
                  <div>
                    <h3 class="font-extrabold text-sm text-stone-900 leading-tight">{launchData.map.hubName}</h3>
                    <p class="text-[11px] text-stone-500">
                      <span class="lang-km">{launchData.map.descKm}</span>
                      <span class="lang-en">{launchData.map.descEn}</span>
                    </p>
                  </div>
                </div>
                <a
                  href={launchData.map.googleMapsUrl || "https://maps.google.com/?q=Battambang%20City,%20Cambodia"}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[11px] font-bold text-white bg-emerald-700 hover:bg-emerald-600 px-2.5 py-1 rounded-full shrink-0 transition-colors flex items-center gap-1 shadow-2xs"
                >
                  <span>Google Maps</span>
                </a>
              </div>

              <!-- Zones Pill List -->
              <div class="flex flex-wrap items-center gap-1.5 pt-2 border-t border-stone-100 text-[11px]">
                <span class="text-stone-400 font-semibold mr-1">
                  <span class="lang-km">តំបន់៖</span>
                  <span class="lang-en">Zones:</span>
                </span>
                {launchData.map.districts.map((d) => (
                  <span class="px-2.5 py-0.5 rounded-lg bg-stone-100/90 text-stone-700 font-semibold border border-stone-200/80">{d}</span>
                ))}
              </div>
            </div>
          </div>

          <!-- Bottom delivery stats from JSON -->
          <div class="grid grid-cols-3 gap-2 pt-2 text-center text-xs">
            {launchData.map.stats.map((stat) => (
              <div class="p-2.5 rounded-xl bg-stone-50 border border-stone-100">
                <span class="block text-base font-black text-emerald-700">{stat.value}</span>
                <span class="text-[11px] text-stone-500">
                  <span class="lang-km">{stat.labelKm}</span>
                  <span class="lang-en">{stat.labelEn}</span>
                </span>
              </div>
            ))}
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
