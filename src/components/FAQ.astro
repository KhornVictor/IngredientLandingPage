---
import faqData from '../../public/contents/FAQ.json';
---

<section id="faq" class="py-20 md:py-28 bg-stone-50/70 border-b border-stone-200/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-emerald-800 text-xs font-bold uppercase tracking-wider mb-3">
        <span class="lang-km">{faqData.badge.km}</span>
        <span class="lang-en">{faqData.badge.en}</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
        <span class="lang-km">{faqData.title.km}</span>
        <span class="lang-en">{faqData.title.en}</span>
      </h2>
      <p class="text-base sm:text-lg text-stone-600">
        <span class="lang-km">{faqData.description.km}</span>
        <span class="lang-en">{faqData.description.en}</span>
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {faqData.faqs.map((faq) => (
        <div class="faq-item rounded-2xl bg-white border border-stone-200 overflow-hidden shadow-xs transition-all duration-200">
          <button
            type="button"
            class="faq-btn w-full p-6 text-left flex items-center justify-between gap-4 font-bold text-base text-stone-900 hover:text-emerald-700 transition-colors"
          >
            <span>
              <span class="lang-km">{faq.questionKm}</span>
              <span class="lang-en">{faq.questionEn}</span>
            </span>
            <span class="faq-icon w-7 h-7 rounded-full bg-stone-100 flex items-center justify-center text-stone-500 shrink-0 transition-transform duration-200">
              ↓
            </span>
          </button>
          <div class="faq-content hidden px-6 pb-6 text-sm text-stone-600 leading-relaxed border-t border-stone-100 pt-3">
            <p class="lang-km" set:html={faq.answerKm} />
            <p class="lang-en" set:html={faq.answerEn} />
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  // Accordion toggle behavior
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('.faq-icon');
      const isHidden = content.classList.contains('hidden');

      // Close all other open accordions
      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-icon').forEach(i => {
        i.textContent = '↓';
        i.classList.remove('rotate-180');
      });

      if (isHidden) {
        content.classList.remove('hidden');
        if (icon) {
          icon.textContent = '↑';
          icon.classList.add('rotate-180');
        }
      }
    });
  });
</script>
