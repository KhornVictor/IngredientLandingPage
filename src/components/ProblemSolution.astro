---
import problemSolutions from '../../public/contents/ProblemSolution.json';

interface ProblemSolutionItem {
  id: number;
  problem: {
    titleKm: string;
    titleEn: string;
    descKm: string;
    descEn: string;
  };
  solution: {
    titleKm: string;
    titleEn: string;
    descKm: string;
    descEn: string;
  };
}

const items: ProblemSolutionItem[] = problemSolutions;
---

<section id="problems" class="py-20 md:py-28 bg-white border-y border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-red-700 text-xs font-bold uppercase tracking-wider mb-3">
        <span class="lang-km">បញ្ហាប្រឈម & ដំណោះស្រាយ</span>
        <span class="lang-en">The Problem & Our Solution</span>
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight mb-4">
        <span class="lang-km">ហេតុអ្វីបានជាការធ្វើម្ហូបនៅផ្ទះតែងតែជួបផលលំបាក?</span>
        <span class="lang-en">Why Is Home Cooking Often So Frustrating?</span>
      </h2>
      <p class="text-base sm:text-lg text-stone-600">
        <span class="lang-km">មនុស្សជាច្រើនចង់ចម្អិនអាហារញ៉ាំខ្លួនឯង ប៉ុន្តែត្រូវប្រឈមនឹងការស្មុគស្មាញក្នុងការទិញគ្រឿង ការខ្ជះខ្ជាយ និងខ្វះជំនាញ។ <strong>ក្រុមហ៊ុន អ៊ីនហ្គ្រីដៀន </strong> បង្កើតឡើងដើម្បីដោះស្រាយបញ្ហាទាំងនេះ!</span>
        <span class="lang-en">Most people want to cook at home, but face grocery chaos, excessive waste, and recipe guesswork. <strong>Ingredient Company</strong> provides an all-in-one solution.</span>
      </p>
    </div>

    <!-- Contrast Cards Grid Rendered from JSON -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {items.map((item) => (
        <div class="rounded-3xl p-7 border border-stone-200 hover:border-emerald-300 transition-all duration-300 hover:shadow-lg flex flex-col justify-between group">
          <div>
            <div class="mb-5 p-4 rounded-2xl bg-red-700">
              <div class="flex items-start gap-3">
                <span class="w-8 h-8 rounded-xl text-white bg-red-600 flex items-center justify-center font-bold text-sm shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x preview-icon"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </span>
                <div>
                  <h4 class="text-sm font-bold text-white mb-1">
                    <span class="lang-km">{item.problem.titleKm}</span>
                    <span class="lang-en">{item.problem.titleEn}</span>
                  </h4>
                  <p class="text-xs text-white/90 leading-relaxed">
                    <span class="lang-km">{item.problem.descKm}</span>
                    <span class="lang-en">{item.problem.descEn}</span>
                  </p>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-center -my-2 text-emerald-600">
              <svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </div>

            <div class="mt-3 p-4 rounded-2xl bg-emerald-700">
              <div class="flex items-start gap-3">
                <span class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check preview-icon"><path d="M20 6 9 17l-5-5"/></svg>
                </span>
                <div>
                  <h4 class="text-sm font-bold text-white mb-1">
                    <span class="lang-km">{item.solution.titleKm}</span>
                    <span class="lang-en">{item.solution.titleEn}</span>
                  </h4>
                  <p class="text-xs text-white/90 leading-relaxed">
                    <span class="lang-km">{item.solution.descKm}</span>
                    <span class="lang-en">{item.solution.descEn}</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
