---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ingredient Company",
  description = "Fresh pre-measured cooking kits with step-by-step video tutorials. Save time, eliminate food waste, and cook delicious meals at home. Launching in Battambang City."
} = Astro.props;
---

<!doctype html>
<html lang="km" data-lang="km">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="https://cdn-icons-png.flaticon.com/512/6330/6330592.png" />
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/6330/6330592.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts for English and Khmer -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:ital,wght@0,300..700;1,300..700&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet">

    <!-- Anti-flicker script for instant language preference -->
    <script is:inline>
      const savedLang = localStorage.getItem('ingoude_lang') || 'km';
      document.documentElement.setAttribute('data-lang', savedLang);
      document.documentElement.setAttribute('lang', savedLang);
    </script>
  </head>
  <body class="bg-[#fafaf9] text-stone-800 antialiased selection:bg-emerald-100 selection:text-emerald-900 overflow-x-hidden">
    <slot />
  </body>
</html>
